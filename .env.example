# Groq API key for LLM extraction and answer generation
GROQ_API_KEY=replace_with_your_groq_api_key

# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_a_strong_unique_password

# Qdrant connection
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pump_assembly
